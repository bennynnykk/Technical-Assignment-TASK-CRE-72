# Copy to .env (never commit .env). Only DB_URI is needed for the optional database step.
# The psycopg3 driver prefix is required: postgresql+psycopg://
# These values match the throwaway local container in docker-compose.yml.
DB_URI=postgresql+psycopg://iris_candidate:local_test_only@localhost:5432/iris

# Optional: valuation date for lease / WALT calculations (ISO date).
# Defaults to 2026-11-01 so results are reproducible. Leave unset unless you need another date.
# AS_OF_DATE=2026-11-01
